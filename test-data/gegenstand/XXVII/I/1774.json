"/dokument/XXVII/ME/213/fnameorig_1451888.html","type":"HTML"}],"title":"Begleitschreiben"},{"documents":[{"link":"/dokument/XXVII/ME/213/fname_1451889.pdf","type":"PDF"},{"link":"/dokument/XXVII/ME/213/fnameorig_1451889.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVII/ME/213/fname_1451890.pdf","type":"PDF"},{"link":"/dokument/XXVII/ME/213/fnameorig_1451890.html","type":"HTML"}],"title":"Vorblatt und Wirkungsorientierte Folgenabschätzung"},{"documents":[{"link":"/dokument/XXVII/ME/213/fname_1451891.pdf","type":"PDF"},{"link":"/dokument/XXVII/ME/213/fnameorig_1451891.html","type":"HTML"}],"title":"Erläuterungen"}],"gp_code":"XXVII","inr":213,"ityp":"ME","shortinfo":{"redaktion":"<p class=\"kurzinfoStand\"><strong>Redaktion: <a href=\"https://oesterreich.gv.at/\"><strong>oesterreich.gv.at</strong></a></strong><br/></p>","stand":"14.06.2022","teil1":"<h4>Ziel</h4>\n\n<ul class=\"unordered-list\">\n\t<li>Verringerung der Kostenbelastung von Unternehmen aufgrund hoher Strompreiskosten</li>\n</ul>\n\n<h4>Inhalt</h4>\n\n<ul class=\"unordered-list\">\n\t<li>F&ouml;rderung zum Ausgleich hoher Strompreiskosten</li>\n</ul>\n\n<h4>Hauptgesichtspunkte des Entwurfs</h4>\n\n<p>Im Zusammenhang mit den infolge der allgemeinen wirtschaftlichen Entwicklung, der Zertifikatspreise im europ&auml;ischen Emissionshandel sowie des russischen Angriffskriegs gegen die Ukraine gestiegenen Strompreise soll energieintensiven Unternehmen ein finanzieller Ausgleich gew&auml;hrt werden k&ouml;nnen.</p>\n\n<p>Die Kostenbelastung von anspruchsberechtigten Unternehmen, die im Jahr 2022 von erheblich gestiegenen Strompreiskosten besonders betroffen sind, soll verringert werden. Zu dem Zweck sollen Unternehmen in anspruchsberechtigten Sektoren oder Teilsektoren eine F&ouml;rderung in Form von direkten Zusch&uuml;ssen erhalten. Die F&ouml;rderung soll einen Ausgleich der indirekten CO2-Kosten im Kalenderjahr 2022 umfassen.</p>\n\n<p>Damit soll das Risiko der Verlagerung von CO2-Emissionen reduziert werden. Die auf diese Weise gew&auml;hrten Bundesf&ouml;rderungen werden im Rahmen der Privatwirtschaftsverwaltung abgewickelt. Verfassungsrechtliche Grundlage f&uuml;r die vorgesehenen Regelungen ist Art. 17 B-VG.</p>\n","teil2":null,"titel":"Strompreiskosten-Ausgleichsgesetz 2022, SAG 2022 (213/ME)"},"url":"/gegenstand/XXVII/ME/213","zitation":"213/ME","zukz":null}],"process":"J","progress":[{"empty":false,"id":1,"name":"Einlangen NR"},{"empty":false,"id":3,"name":"Ausschussberatungen NR"},{"empty":false,"id":4,"name":"Plenarberatungen NR"},{"empty":false,"id":5,"name":"Einlangen BR"},{"empty":false,"id":6,"name":"Ausschussberatungen BR"},{"empty":false,"id":7,"name":"Plenarberatungen BR"}],"reference":[{"art":"B","subject":"Strompreiskosten-Ausgleichsgesetz 2022, SAG 2022","text":"Bezug zu","url":"/gegenstand/XXVII/ME/213","zitation":"213/ME"}],"shortinfo":{"stand":"02.11.2022","teil1":"<h4>Schwerpunkt der Regierungsvorlage</h4>\nUnternehmen in anspruchsberechtigten Sektoren oder Teilsektoren erhalten eine F&ouml;rderung in Form von direkten Zusch&uuml;ssen. Die F&ouml;rderung umfasst einen Ausgleich der indirekten CO2-Kosten im Kalenderjahr 2022.","teil2":null,"titel":"Strompreiskosten-Ausgleichsgesetz 2022, SAG 2022"},"sntype":"Regierungsvorlage: Bundes(verfassungs)gesetz","statements":{"documents":[{"documents":[{"link":"/dokument/XXVII/I/1774/fname_1479068.pdf","type":"PDF"},{"link":"/dokument/XXVII/I/1774/fnameorig_1479068.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVII/I/2051/fname_1567651.pdf","type":"PDF"},{"link":"/dokument/XXVII/I/2051/fnameorig_1567651.html","type":"HTML"}],"title":"Geändert im Ausschuss"}],"filter":{"data":{"definition":{"ascDesc":"DESC","bez":"FP_142_vhg","fixedParams":{"BEZUG_GP_CODE":["XXVII"],"BEZUG_INR":[1774],"BEZUG_ITYP":["I"]},"hideColumns":["16","17"],"hideDimensions":["BEZUG_GP_CODE","BEZUG_ITYP","BEZUG_INR"],"listeId":142,"params":{"BEZUG_GP_CODE":["XXVII"],"BEZUG_INR":[1774],"BEZUG_ITYP":["I"]},"sortrnr":5},"hasForm":true,"hasList":true,"label":"Stellungnahmen","pagesize":20,"resultLayout":"TABLE","type":"FILTER"},"rendertype":"filter"},"new":0},"statementsstate":"0","status":{"bgbllinks":[{"link":"http://www.ris.bka.gv.at/Dokument.wxe?Abfrage=BgblAuth&Dokumentnummer=BGBLA_2023_I_58","title":"Bundesgesetzblatt I Nr. 58/2023","type":"DEFAULT"},{"link":"http://www.ris.bka.gv.at/Ergebnis.wxe?Abfrage=Bundesnormen&Kundmachungsorgan=BGBl.+I+Nr.&Kundmachungsnummer=58%2f2023&Suchworte=&ReturnUrl=%2fSuchen.wxe%3fQueryID%3dBundesnormen","title":"Kunsttext","type":"DEFAULT"}],"description":"Beschlossen im Bundesrat <a href=\"/gegenstand/XXVII/BNR/745\">745/BNR</a><br>Dafür: ÖVP, FPÖ, GRÜNE, OF, dagegen: SPÖ<br>Beschlossen im Nationalrat <a href=\"/gegenstand/XXVII/BNR/745\">745/BNR</a>, Dafür: ÖVP, FPÖ, GRÜNE, NEOS, dagegen: SPÖ","number":5},"title":"Strompreiskosten-Ausgleichsgesetz 2022, SAG 2022","topics":{"data":{"bubbles":[{"label":"Budget und Finanzen","link":"/suche?thema=Budget und Finanzen"},{"label":"Klima, Umwelt und Energie","link":"/suche?thema=Klima, Umwelt und Energie"},{"label":"Wirtschaft","link":"/suche?thema=Wirtschaft"}],"title":""},"rendertype":"bubbles"},"type":"Regierungsvorlage: Bundes(verfassungs)gesetz","update":"2026-02-16T09:18:12","vhg_fertig":"J","vhg_fertig_docs":"J","vote":{"code":"VsFGN","comment":null,"infavor":true,"result":[{"code":"V","color":"#62C3D0","fraction":71,"infavor":true,"text":"ÖVP"},{"code":"S","color":"#FF0000","fraction":40,"infavor":false,"text":"SPÖ"},{"code":"F","color":"#0052FB","fraction":30,"infavor":true,"text":"FPÖ"},{"code":"G","color":"#69B12E","fraction":26,"infavor":true,"text":"GRÜNE"},{"code":"N","color":"#E3257B","fraction":15,"infavor":true,"text":"NEOS"}],"text":"Dafür: V, F, G, N. Dagegen: S"},"zitation":"1774 d.B."},"meta":{"description":"Strompreiskosten-Ausgleichsgesetz 2022, SAG 2022 (1774 d.B.)","generationTime":"Mon Feb 16 08:18:29 UTC 2026","keywords":"