url":"/aktuelles/mediathek/BR/BRSITZ/980?DEBATTE=3&TS=1752756629"}],["<a href=\"/person/31964\" target=\"_blank\">Werner Gradwohl (F/St)</a>","Contra",[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"text":"RN/47","title":"12:56:15 - Werner Gradwohl (FPÖ/Stmk.) - TOP 5 Messenger-Überwachung (RN/47)","url":"/dokument/BR/BRSITZ/980/fnameorig_1752660.html#47"}],{"url":"/aktuelles/mediathek/BR/BRSITZ/980?DEBATTE=3&TS=1752756983"}],["<a href=\"/person/33458\" target=\"_blank\">Andreas Guggenberger (F/W)</a>","Contra",[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"text":"RN/48","title":"13:11:30 - Andreas Guggenberger (FPÖ/W) - TOP 5 Messenger-Überwachung (RN/48)","url":"/dokument/BR/BRSITZ/980/fnameorig_1752660.html#48"}],{"url":"/aktuelles/mediathek/BR/BRSITZ/980?DEBATTE=3&TS=1752757898"}],["<a href=\"/person/24113\" target=\"_blank\">Sandra Lassnig (V/K)</a>","Pro",[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"text":"RN/49","title":"13:17:38 - Sandra Lassnig (ÖVP/Ktn.) - TOP 5 Messenger-Überwachung (RN/49)","url":"/dokument/BR/BRSITZ/980/fnameorig_1752660.html#49"}],{"url":"/aktuelles/mediathek/BR/BRSITZ/980?DEBATTE=3&TS=1752758265"}],["<a href=\"/person/3459\" target=\"_blank\">Andreas Arthur Spanring (F/N)</a>","Contra",[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"text":"RN/50","title":"13:20:37 - Andreas Arthur Spanring (FPÖ/NÖ) - TOP 5 Messenger-Überwachung (RN/50)","url":"/dokument/BR/BRSITZ/980/fnameorig_1752660.html#50"}],{"url":"/aktuelles/mediathek/BR/BRSITZ/980?DEBATTE=3&TS=1752758443"}]]},"rendertype":"table"},"text":"Wortmeldungen in der Debatte"},{"date":"17.07.2025","fsth":[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"text":"RN/51","title":"13:28:32 - Abstimmung - TOP 5 Messenger-Überwachung (RN/51)","url":"/dokument/BR/BRSITZ/980/fnameorig_1752660.html#51"}],"text":"980. Sitzung: Antrag, keinen Einspruch zu erheben, <b>angenommen</b><br>Namentliche Abstimmung (abgegebene Stimmen: 59; 40 Ja-Stimmen, 19 Nein-Stimmen)"},{"date":"17.07.2025","fsth":[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"text":"RN/44","title":"12:31:15 - Günter Pröller (FPÖ/OÖ) - TOP 5 Messenger-Überwachung (RN/44)","url":"/dokument/BR/BRSITZ/980/fnameorig_1752660.html#44"}],"text":"980. Sitzung: Unselbständiger Entschließungsantrag der Bundesräte <a href=\"/person/20233\" target=\"_blank\">Günter Pröller</a>, Kolleginnen und Kollegen betreffend <a href=\"/gegenstand/BR/UEA-BR/763\">Stärkung des Staatsschutzes im Kampf gegen den islamistischen Terrorismus (763/UEA-BR/2025)</a><br><b>abgelehnt</b><br>Dafür: FPÖ, dagegen: ÖVP, SPÖ, GRÜNE, NEOS"},{"date":"17.07.2025","priority":1,"text":"Beschluss im Bundesrat <a href=\"/gegenstand/XXVIII/BNR/40\">40/BNR</a>"}]}],"preconst":[{"betreff":"Staatsschutz- und Nachrichtendienst-Gesetz, Sicherheitspolizeigesetz u.a., Änderung","description":"Ministerialentwurf betreffend Bundesgesetz, mit dem das Staatsschutz- und Nachrichtendienst-Gesetz, das Sicherheitspolizeigesetz, das Telekommunikationsgesetz 2021, das Bundesverwaltungsgerichtsgesetz und das Richter- und Staatsanwaltschaftsdienstgesetz geändert werden","documents":[{"documents":[{"link":"/dokument/XXVIII/ME/8/imfname_1676530.pdf","type":"PDF"}],"title":"Kurzinformation"},{"documents":[{"link":"/dokument/XXVIII/ME/8/imfname_1676473.pdf","type":"PDF"}],"title":"Begleitschreiben"},{"documents":[{"link":"/dokument/XXVIII/ME/8/fname_1676474.pdf","type":"PDF"},{"link":"/dokument/XXVIII/ME/8/fnameorig_1676474.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVIII/ME/8/imfname_1676475.pdf","type":"PDF"}],"title":"Vorblatt und wirkungsorientierte Folgenabschätzung"},{"documents":[{"link":"/dokument/XXVIII/ME/8/fname_1676476.pdf","type":"PDF"},{"link":"/dokument/XXVIII/ME/8/fnameorig_1676476.html","type":"HTML"}],"title":"Erläuterungen"},{"documents":[{"link":"/dokument/XXVIII/ME/8/imfname_1676477.pdf","type":"PDF"}],"title":"Textgegenüberstellung"}],"gp_code":"XXVIII","inr":8,"ityp":"ME","shortinfo":{"redaktion":"<p class=\"kurzinfoStand\"><strong>Redaktion: <a href=\"https://oesterreich.gv.at/\"><strong>oesterreich.gv.at</strong></a></strong><br/></p>","stand":"08.04.2025","teil1":"<h4>Ziel</h4>\n\n<p>Sicherstellung moderner, zweckm&auml;&szlig;iger und effizienter Ermittlungen durch den Verfassungsschutz</p>\n\n<h4>Inhalt&nbsp;</h4>\n\n<ul class=\"unordered-list\">\n\t<li>Einf&uuml;hrung einer Ermittlungsbefugnis zur &Uuml;berwachung von Nachrichten, einschlie&szlig;lich verschl&uuml;sselter Kommunikation (&sect; 11 Abs. 1 Z 8 und 9 Staatsschutz-&nbsp;und Nachrichtendienst-Gesetz [SNG])</li>\n\t<li>Einf&uuml;hrung der Erm&auml;chtigung der Direktorin/des Direktors, den Nachrichtendienst mit der Wahrnehmung von Aufgaben nach &sect; 6 Abs. 2 SNG zu betrauen</li>\n\t<li>Neuregelung des Aufschubs der Berichtspflicht (&sect; 6 Abs. 4 SNG)</li>\n\t<li>Einf&uuml;hrung einer verpflichtenden Vertrauensw&uuml;rdigkeitspr&uuml;fung f&uuml;r die Rechtsschutzbeauftragte/den Rechtsschutzbeauftragten sowie deren/dessen Stellvertretung (&sect; 91b Abs. 1a Sicherheitspolizeigesetz [SPG])</li>\n\t<li>Erweiterung von Umst&auml;nden, die zu einer Erl&ouml;schung der Bestellung bzw. Abberufung der/des Rechtsschutzbeauftragen f&uuml;hren (&sect; 91b Abs. 2 und 2a SPG)</li>\n\t<li>Aktualisierung der Verweise in &sect; 161 und &sect; 162 Telekommunikationsgesetz (TKG)</li>\n\t<li>Schaffung einer Rechtsgrundlage f&uuml;r eine Rufbereitschaft oder einen Journaldienst am Bundesverwaltungsgericht (&sect; 16a Bundesverwaltungsgerichtsgesetz (BVwGG) und &sect; 66 Abs. 3 Richter- und Staatsanwaltschaftsdienstgesetz (RStDG)</li>\n</ul>\n","teil2":"<h4>Hauptgesichtspunkte des Entwurfs</h4>\n\n<p>Mit dieser Novelle soll f&uuml;r den Aufgabenbereich des Verfassungsschutzes eine gesonderte M&ouml;glichkeit geschaffen werden, sicherheitspolizeiliches Einschreiten oder kriminalpolizeiliche Ermittlungen aufzuschieben. Voraussetzung daf&uuml;r ist, dass ein &uuml;berwiegendes Interesse an der Erf&uuml;llung der Aufgabe nach &sect; 6 Abs. 1 oder 2 SNG besteht.<br />\nDie Praxis hat gezeigt, dass die strikte Aufgabenzuweisung der erweiterten Gefahrenerforschung zur Beobachtung einer Gruppierung (&sect; 6 Abs. 1 SNG) und des vorbeugenden Schutzes vor verfassungsgef&auml;hrdenden Angriffen durch Einzelpersonen (&sect; 6 Abs. 2 SNG) zu den f&uuml;r den Nachrichtendienst (Direktion) bzw. f&uuml;r den Staatsschutz zust&auml;ndigen Organisationseinheiten, trotz Informationsschnittstelle eine rasche, zweckm&auml;&szlig;ige und effiziente Aufgabenerf&uuml;llung erschweren kann. Deshalb soll eine Rechtsgrundlage geschaffen werden, damit die Direktorin/der Direktor im Einzelfall unter gesetzlich festgelegten Kriterien den Aufgabenbereich Nachrichtendienst zu der Wahrnehmung einer Aufgabe nach &sect; 6 Abs. 2 SNG (Staatsschutz) erm&auml;chtigen kann. &nbsp;<br />\nWeiters soll im SNG eine Rechtsgrundlage geschaffen werden, um in gesetzlich definierten F&auml;llen die &Uuml;berwachung von Inhaltsdaten nach dem Vorbild der Regelungen der Strafprozessordnung (StPO)&nbsp;zu erm&ouml;glichen. Angesichts der&nbsp;&ndash; vor allem im Bereich grenz&uuml;berschreitender terroristischer Aktivit&auml;ten&nbsp;&ndash; zunehmenden Verlagerung herk&ouml;mmlicher, unverschl&uuml;sselter Telekommunikation auf internetbasierte, zumeist end-to-end-verschl&uuml;sselte Kommunikation (z.B. WhatsApp, Skype oder Signal) soll zus&auml;tzlich eine Rechtsgrundlage geschaffen werden, um verschl&uuml;sselte Nachrichten zur effektiven Bek&auml;mpfung verfassungsschutzrelevanter Bedrohungslagen zu &uuml;berwachen.<br />\nEs sollen Erg&auml;nzungen des Deliktskatalogs der verfassungsgef&auml;hrdenden Angriffe um f&uuml;r den Verfassungsschutz relevante Tatbest&auml;nde&nbsp;insbesondere des Strafgesetzbuches und des Waffengesetzes vorgenommen werden.<br />\nWeitere Anpassungen des SPG sollen eine verpflichtende Vertrauensw&uuml;rdigkeitspr&uuml;fung der/des Rechtsschutzbeauftragten, ihrer/seiner Stellvertretung (und sonstiger Mitarbeiterinnen/Mitarbeiter im administrativen Bereich) sowie die M&ouml;glichkeit von deren Abberufung im Falle grober Pflichtverletzungen oder einer nachtr&auml;glichen Unvereinbarkeit mit der Funktion durch die Bundespr&auml;sidentin/den Bundespr&auml;sidenten sicherstellen.<br />\nMit den &Auml;nderungen des TKG sollen Anpassungen vorgenommen werden, die f&uuml;r die allf&auml;llige Mitwirkung der Anbieterinnen/Anbieter von Kommunikationsdiensten an der Nachrichten&uuml;berwachung erforderlich sind. Schlie&szlig;lich soll durch Anpassungen im BVwGG und im RStDG eine Rufbereitschaft sowie ein Journaldienst beim Bundesverwaltungsgericht erm&ouml;glicht werden.</p>\n","titel":"Kurzinformation"},"url":"/gegenstand/XXVIII/ME/8","zitation":"8/ME","zukz":null}],"process":"J","progress":[{"empty":false,"id":1,"name":"Einlangen NR"},{"empty":false,"id":3,"name":"Ausschussberatungen NR"},{"empty":false,"id":4,"name":"Plenarberatungen NR"},{"empty":false,"id":5,"name":"Einlangen BR"},{"empty":false,"id":6,"name":"Ausschussberatungen BR"},{"empty":false,"id":7,"name":"Plenarberatungen BR"}],"reference":[{"art":"B","subject":"Staatsschutz- und Nachrichtendienst-Gesetz, Sicherheitspolizeigesetz u.a., Änderung","text":"Bezug zu","url":"/gegenstand/XXVIII/ME/8","zitation":"8/ME"}],"shortinfo":{"stand":"18.06.2025","teil1":"<ul class=\"unordered-list\">\n\t<li>Einf&uuml;hrung einer Ermittlungsbefugnis zur &Uuml;berwachung von Nachrichten, einschlie&szlig;lich verschl&uuml;sselter Kommunikation (&sect; 11 Abs 1 Z 8 und 9 SNG)</li>\n\t<li>Neuregelung des Aufschubs der Berichtspflicht (&sect; 6 Abs 4 SNG)</li>\n</ul>\n","teil2":"<ul class=\"unordered-list\">\n\t<li>Einf&uuml;hrung einer verpflichtenden Vertrauensw&uuml;rdigkeitspr&uuml;fung f&uuml;r den Rechtsschutzbeauftragten sowie seine Stellvertreter (&sect; 91b Abs. 1a SPG)</li>\n\t<li>Erweiterung von Umst&auml;nden, die zu einer Erl&ouml;schung der Bestellung bzw. Abberufung des Rechtsschutzbeauftragen f&uuml;hren (&sect; 91b Abs. 2 und 2a SPG)</li>\n\t<li>Aktualisierung der Verweise in &sect; 161 und &sect; 162 TKG</li>\n\t<li>Schaffung einer Rechtsgrundlage f&uuml;r eine Rufbereitschaft oder einen Journaldienst am Bundesverwaltungsgericht (&sect; 16a BVwGG und &sect; 66 Abs. 3 RStDG)</li>\n</ul>\n","titel":"Kurzinformation"},"sntype":"Regierungsvorlage: Bundes(verfassungs)gesetz","statements":{"documents":[{"documents":[{"link":"/dokument/XXVIII/I/136/fname_1693648.pdf","type":"PDF"},{"link":"/dokument/XXVIII/I/136/fnameorig_1693648.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVIII/I/164/fname_1697036.pdf","type":"PDF"},{"link":"/dokument/XXVIII/I/164/fnameorig_1697036.html","type":"HTML"}],"title":"Geändert im Ausschuss"}],"filter":{"data":{"definition":{"ascDesc":"DESC","bez":"FP_142_vhg","fixedParams":{"BEZUG_GP_CODE":["XXVIII"],"BEZUG_INR":[136],"BEZUG_ITYP":["I"]},"hideColumns":["16","17"],"hideDimensions":["BEZUG_GP_CODE","BEZUG_ITYP","BEZUG_INR"],"listeId":142,"params":{"BEZUG_GP_CODE":["XXVIII"],"BEZUG_INR":[136],"BEZUG_ITYP":["I"]},"sortrnr":5},"hasForm":true,"hasList":true,"label":"Stellungnahmen","pagesize":20,"resultLayout":"TABLE","type":"FILTER"},"rendertype":"filter"},"new":0},"statementsstate":"0","status":{"bgbllinks":[{"link":"http://www.ris.bka.gv.at/Dokument.wxe?Abfrage=BgblAuth&Dokumentnummer=BGBLA_2025_I_54","title":"Bundesgesetzblatt I Nr. 54/2025","type":"DEFAULT"},{"link":"http://www.ris.bka.gv.at/Ergebnis.wxe?Abfrage=Bundesnormen&Kundmachungsorgan=BGBl.+I+Nr.&Kundmachungsnummer=54%2f2025&Suchworte=&ReturnUrl=%2fSuchen.wxe%3fQueryID%3dBundesnormen","title":"Kunsttext","type":"DEFAULT"}],"description":"Beschlossen im Bundesrat <a href=\"/gegenstand/XXVIII/BNR/40\">40/BNR</a><br>Namentliche Abstimmung (abgegebene Stimmen: 59; 40 Ja-Stimmen, 19 Nein-Stimmen)<br>Beschlossen im Nationalrat <a href=\"/gegenstand/