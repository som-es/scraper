le":"16:17:12 - Abstimmung - TOP 11-13 Änderungen im Sozialversicherungsrecht (RN/95.2)","url":"/dokument/BR/BRSITZ/985/A_-_16_17_12_00891163.html#95.2"}],"text":"985. Sitzung: Antrag, keinen Einspruch zu erheben, <b>angenommen</b><br>Dafür: ÖVP, SPÖ, NEOS, dagegen: FPÖ, GRÜNE"},{"date":"18.12.2025","priority":1,"text":"Beschluss im Bundesrat <a href=\"/gegenstand/XXVIII/BNR/114\">114/BNR</a>"}]}],"preconst":[{"betreff":"DokuG-Novelle 2025","description":"Ministerialentwurf betreffend Bundesgesetz, mit dem das Bundesgesetz über die Dokumentation im Gesundheitswesen geändert wird (DokuG-Novelle 2025)","documents":[{"documents":[{"link":"/dokument/XXVIII/ME/64/imfname_1719968.pdf","type":"PDF"}],"title":"Kurzinformation"},{"documents":[{"link":"/dokument/XXVIII/ME/64/imfname_1719925.pdf","type":"PDF"}],"title":"Begleitschreiben"},{"documents":[{"link":"/dokument/XXVIII/ME/64/fname_1719926.pdf","type":"PDF"},{"link":"/dokument/XXVIII/ME/64/fnameorig_1719926.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVIII/ME/64/imfname_1719927.pdf","type":"PDF"}],"title":"Vorblatt und wirkungsorientierte Folgenabschätzung"},{"documents":[{"link":"/dokument/XXVIII/ME/64/fname_1719928.pdf","type":"PDF"},{"link":"/dokument/XXVIII/ME/64/fnameorig_1719928.html","type":"HTML"}],"title":"Erläuterungen"},{"documents":[{"link":"/dokument/XXVIII/ME/64/imfname_1719929.pdf","type":"PDF"}],"title":"Textgegenüberstellung"},{"documents":[{"link":"/dokument/XXVIII/ME/64/imfname_1719930.pdf","type":"PDF"}],"title":"Datenschutz-Folgenabschätzung"}],"gp_code":"XXVIII","inr":64,"ityp":"ME","shortinfo":{"redaktion":"<p class=\"kurzinfoStand\"><strong>Redaktion: <a href=\"https://oesterreich.gv.at/\"><strong>oesterreich.gv.at</strong></a></strong><br/></p>","stand":"31.10.2025","teil1":"<h4>Ziele</h4>\n\n<ul class=\"unordered-list\">\n\t<li>Weiterentwicklung und Fortf&uuml;hrung des implementierten partnerschaftlichen Zielsteuerungssystems</li>\n\t<li>Weiterentwicklung der gemeinsamen Planung im Rahmen der Zielsteuerung-Gesundheit</li>\n\t<li>Gew&auml;hrleistung einer bedarfsgerechten Versorgung mit Arzneimitteln</li>\n\t<li>Verbesserung der Planungs- und Qualit&auml;tsarbeit</li>\n\t<li>Auf- und Ausbau der &ouml;ffentlichen Gesundheitstelematikinfrastruktur</li>\n\t<li>Neustrukturierung der Qualit&auml;tssicherung im Gesundheitswesen</li>\n</ul>\n\n<h4>Inhalt</h4>\n\n<ul class=\"unordered-list\">\n\t<li>Gesetzliche Umsetzung der Art.-15a-Vereinbarungen</li>\n\t<li>Schaffung der rechtlichen Rahmenbedingungen zur &Uuml;berarbeitung der Planungsinstrumente der Zielsteuerung-Gesundheit</li>\n\t<li>Bewertungsboard f&uuml;r Arzneimittel</li>\n\t<li>Verbesserung der Datengrundlagen f&uuml;r Planungs- und Qualit&auml;tsarbeit</li>\n\t<li>Erweiterung der Nutzungspflicht der elektronischen Gesundheitsakte (ELGA) und Erh&ouml;hung der Sicherheit von Netz- und Informationssystemen f&uuml;r Anbieterinnen/Anbieter von Gesundheitsdiensten</li>\n\t<li>Aufbau einer neuen Abteilung in der G&Ouml;G (Gesundheit &Ouml;sterreich GmbH<i>)</i> bzw. im BIQG (Bundesinstitut f&uuml;r Qualit&auml;t im Gesundheitswesen)</li>\n\t<li>Etablierung einer unabh&auml;ngigen Qualit&auml;tskontrolle</li>\n\t<li>Einbindung der relevanten Stakeholder in das neue Qualit&auml;tssicherungssystem</li>\n</ul>\n","teil2":"<h4>Hauptgesichtspunkte des Entwurfs</h4>\nIm Zuge der im Jahr 2023 mit den L&auml;ndern und der Sozialversicherung vereinbarten Gesundheitsreform wurde eine verpflichtende bundesweit einheitliche Diagnosencodierung eingef&uuml;hrt. Eine gemeinsame Dokumentationsbasis im intra- und extramuralen Bereich erm&ouml;glicht nationale und internationale Vergleichbarkeit des Diagnose- und Leistungsspektrums. Eine standardisierte codierte Aufzeichnung liefert die Grundlage f&uuml;r die eigene Patientinnenakte/Patientenakte, eine sichere Behandlung der Patientinnen/Patienten und die Basis f&uuml;r die Kommunikation zwischen &Auml;rztinnen/&Auml;rzten sowie therapeutisch T&auml;tigen. Ein wesentlicher Wert der Dokumentation ist damit die Nutzung der Daten f&uuml;r interne Zwecke.<br />\nF&uuml;r das Gesundheitswesen hat eine mittels ICD-10-Codes codierte Dokumentation eine gewichtige Bedeutung. Die verbesserten Analysem&ouml;glichkeiten k&ouml;nnen im Rahmen folgender Anwendungen genutzt werden: Leistungs- und Strukturplanung (Angebotsplanung); Identifikation von Patienten-Gruppen (z.&nbsp;B. Risikogruppen); Optimierung der Patientinnenstr&ouml;me/Patientenstr&ouml;me (zum Best-Point-of-Service); Gesundheitsberichterstattung; Versorgungsforschung und Epidemiologie; Qualit&auml;tssicherung und -verbesserung (z.&nbsp;B. integrierte Versorgungskonzepte); standardisierter Informationsaustausch. Mit der vorliegenden Novelle sollen neben redaktionellen Anpassungen insbesondere Klarstellungen und Vereinfachungen zum Inhalt der Dokumentation und zu den Meldeprozessen im Bereich der Dokumentation im ambulanten Bereich erfolgen, wie etwa:\n<ol>\n\t<li>Datenmeldungen sollen sowohl f&uuml;r extramurale ambulante Leistungserbringerinnen/Leistungserbringer mit Vertrag als auch solche ohne Vertrag im Wege bestehender Schnittstellen und Satzarten bzw. bekannter Prozesse erfolgen,</li>\n\t<li>statt einer kumulativen Meldung mehrerer Quartale soll im extramuralen ambulanten Bereich jeweils nur ein Quartal zu melden sein,</li>\n\t<li>es soll eine Befreiung von der Meldung geben, wenn die Unzumutbarkeit aufgrund des &Auml;rztegesetzes vorliegt.</li>\n</ol>\n","titel":"Kurzinformation"},"url":"/gegenstand/XXVIII/ME/64","zitation":"64/ME","zukz":null}],"process":"J","progress":[{"empty":false,"id":1,"name":"Einlangen NR"},{"empty":false,"id":3,"name":"Ausschussberatungen NR"},{"empty":false,"id":4,"name":"Plenarberatungen NR"},{"empty":false,"id":5,"name":"Einlangen BR"},{"empty":false,"id":6,"name":"Ausschussberatungen BR"},{"empty":false,"id":7,"name":"Plenarberatungen BR"}],"reference":[{"art":"B","subject":"DokuG-Novelle 2025","text":"Bezug zu","url":"/gegenstand/XXVIII/ME/64","zitation":"64/ME"}],"shortinfo":{"stand":"18.11.2025","teil1":"<ul class=\"unordered-list\">\n\t<li>Gesetzliche Umsetzung der Vereinbarungen gem&auml;&szlig; Art. 15a B-VG</li>\n\t<li>Schaffung der rechtlichen Rahmenbedingungen zur &Uuml;berarbeitung der Planungsinstrumente der Zielsteuerung-Gesundheit (&Ouml;SG und RSG)</li>\n</ul>\n","teil2":"<ul class=\"unordered-list\">\n\t<li>Bewertungsboard Arzneimittel</li>\n\t<li>Verbesserung der Datengrundlagen f&uuml;r Planungs- und Qualit&auml;tsarbeit</li>\n\t<li>Erweiterung der Nutzungspflicht von ELGA und Erh&ouml;hung der Sicherheit von Netz- und Informationssystemen f&uuml;r GDA</li>\n\t<li>Aufbau einer neuen Abteilung in der G&Ouml;G/BIQG</li>\n\t<li>Etablierung einer unabh&auml;ngigen Qualit&auml;tskontrolle</li>\n\t<li>Einbindung der relevanten Stakeholder in das neue Qualit&auml;tssicherungssystem</li>\n</ul>\n","titel":"Kurzinformation"},"sntype":"Regierungsvorlage: Bundes(verfassungs)gesetz","statements":{"documents":[{"documents":[{"link":"/dokument/XXVIII/I/296/fname_1722531.pdf","type":"PDF"},{"link":"/dokument/XXVIII/I/296/fnameorig_1722531.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVIII/I/341/fname_1727703.pdf","type":"PDF"},{"link":"/dokument/XXVIII/I/341/fnameorig_1727703.html","type":"HTML"}],"title":"Geändert im Ausschuss"}],"filter":{"data":{"definition":{"ascDesc":"DESC","bez":"FP_142_vhg","fixedParams":{"BEZUG_GP_CODE":["XXVIII"],"BEZUG_INR":[296],"BEZUG_ITYP":["I"]},"hideColumns":["16","17"],"hideDimensions":["BEZUG_GP_CODE","BEZUG_ITYP","BEZUG_INR"],"listeId":142,"params":{"BEZUG_GP_CODE":["XXVIII"],"BEZUG_INR":[296],"BEZUG_ITYP":["I"]},"sortrnr":5},"hasForm":true,"hasList":true,"label":"Stellungnahmen","pagesize":20,"resultLayout":"TABLE","type":"FILTER"},"rendertype":"filter"},"new":0},"statementsstate":"0","status":{"bgbllinks":[{"link":"http://www.ris.bka.gv.at/Dokument.wxe?Abfrage=BgblAuth&Dokumentnummer=BGBLA_2025_I_116",