<p class=MsoNormal style='margin-top:.70em;margin-right:0cm;margin-bottom:.70em; margin-left:0cm'><i style='mso-bidi-font-style:normal'><span lang=EN-US style='mso-ansi-language:EN-US'>Tamandl, Tancsits, Turkovic-Wendl;<o:p></o:p></span></i></p>
<p class=MsoNormal style='margin-top:.70em;margin-right:0cm;margin-bottom:.70em; margin-left:0cm'><i style='mso-bidi-font-style:normal'><span lang=DE style='mso-ansi-language:DE'>Walch, Winkler, Wittauer, W&ouml;ginger, Wolfmayr;<o:p></o:p></span></i></p>
<p class=MsoNormal style='margin-top:.70em;margin-right:0cm;margin-bottom:.70em; margin-left:0cm'><i style='mso-bidi-font-style:normal'><span lang=DE style='mso-ansi-language:DE'>Zweytick.<u><o:p></o:p></u></span></i></p>
