title":"Seite 109 des Stenographischen Protokolls der 884. Sitzung des Bundesrats","url":"/dokument/BR/BRSITZ/884/fnameorig_750693.html#RU_187882"}],null],["<a href=\"/person/86998\" target=\"_blank\">Mag. Dr. Michael Raml (F/O)</a>","Pro",[{"fund_bis":113,"fund_von":111,"gp_code":"BR","sitzung_id":884,"title":"Seite 111 des Stenographischen Protokolls der 884. Sitzung des Bundesrats","url":"/dokument/BR/BRSITZ/884/fnameorig_750693.html#RU_187875"}],null],["<a href=\"/person/3489\" target=\"_blank\">Christoph Steiner (F/T)</a>","Pro",[{"fund_bis":114,"fund_von":113,"gp_code":"BR","sitzung_id":884,"title":"Seite 113 des Stenographischen Protokolls der 884. Sitzung des Bundesrats","url":"/dokument/BR/BRSITZ/884/fnameorig_750693.html#RU_187855"}],null],["<a href=\"/person/86617\" target=\"_blank\">Armin Forstner, MPA (V/St)</a>","Pro",[{"fund_bis":115,"fund_von":114,"gp_code":"BR","sitzung_id":884,"title":"Seite 114 des Stenographischen Protokolls der 884. Sitzung des Bundesrats","url":"/dokument/BR/BRSITZ/884/fnameorig_750693.html#RU_187864"}],null],["<a href=\"/person/87146\" target=\"_blank\">Mag. Dr. Ewa Dziedzic (G/W)</a>","Contra",[{"fund_bis":116,"fund_von":115,"gp_code":"BR","sitzung_id":884,"title":"Seite 115 des Stenographischen Protokolls der 884. Sitzung des Bundesrats","url":"/dokument/BR/BRSITZ/884/fnameorig_750693.html#RU_187878"}],null]]},"rendertype":"table"},"text":"Wortmeldungen in der Debatte"},{"date":"11.10.2018","fsth":[{"fund_bis":null,"fund_von":116,"gp_code":"BR","sitzung_id":884,"title":"Seite 116 des Stenographischen Protokolls der 884. Sitzung des Bundesrats","url":"/dokument/BR/BRSITZ/884/fnameorig_750693.html#Seite_0116.html"}],"text":"884. Sitzung: Antrag, keinen Einspruch zu erheben, <b>angenommen</b><br>mehrstimmig"},{"date":"11.10.2018","priority":1,"text":"Beschluss im Bundesrat <a href=\"/gegenstand/XXVI/BNR/76\">76/BNR</a>"}]}],"preconst":[{"betreff":"Strafrechtsänderungsgesetz 2018","description":"Ministerialentwurf betreffend Bundesgesetz, mit dem das Strafgesetzbuch und die Strafprozeßordnung 1975 geändert werden (Strafrechtsänderungsgesetz 2018)","documents":[{"documents":[{"link":"/dokument/XXVI/ME/53/imfname_694301.pdf","type":"PDF"}],"title":"Kurzinformation"},{"documents":[{"link":"/dokument/XXVI/ME/53/fname_693899.pdf","type":"PDF"},{"link":"/dokument/XXVI/ME/53/fnameorig_693899.html","type":"HTML"}],"title":"Begleitschreiben"},{"documents":[{"link":"/dokument/XXVI/ME/53/fname_693895.pdf","type":"PDF"},{"link":"/dokument/XXVI/ME/53/fnameorig_693895.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVI/ME/53/fname_693898.pdf","type":"PDF"},{"link":"/dokument/XXVI/ME/53/fnameorig_693898.html","type":"HTML"}],"title":"Vorblatt und Wirkungsorientierte Folgenabschätzung"},{"documents":[{"link":"/dokument/XXVI/ME/53/fname_693896.pdf","type":"PDF"},{"link":"/dokument/XXVI/ME/53/fnameorig_693896.html","type":"HTML"}],"title":"Erläuterungen"},{"documents":[{"link":"/dokument/XXVI/ME/53/fname_693897.pdf","type":"PDF"},{"link":"/dokument/XXVI/ME/53/fnameorig_693897.html","type":"HTML"}],"title":"Textgegenüberstellung"}],"gp_code":"XXVI","inr":53,"ityp":"ME","shortinfo":{"stand":"<strong>Stand: 15.05.2018</strong>","teil1":"<div class=\"\"><h4>Ziele<br/></h4><p><ul class=\"unordered-list\"><li>Vollinhaltliche Umsetzung der Richtlinie Terrorismus im Hinblick auf eine effektive und effiziente Bekämpfung von Terrorismus und Schaffung der Voraussetzungen für eine mögliche Ratifizierung Österreichs des Zusatzprotokolls zum Übereinkommen des Europarats zur Verhütung des Terrorismus<br/></li><li>Bekämpfung der negativen Entwicklung hinsichtlich der Behinderung von Rettungsmaßnahmen bei Unfällen durch Schaulustige<br/></li></ul></p><h4>Inhalt</h4><p><ul class=\"unordered-list\"><li>Erweiterung der inländischen Gerichtsbarkeit im Zusammenhang mit Terrorismus<br/></li><li>Erweiterung des Kataloges der terroristischen Straftaten <br/></li><li>Erweiterung des Katalogs finanzierungstauglicher Straftaten<br/></li><li>Einführung eines neuen Straftatbestandes „Reisen für terroristische Zwecke“ <br/></li><li>Erweiterung des Personenkreises, welcher einen Anspruch auf Prozessbegleitung hat, im Hinblick auf Opfer terroristischer Straftaten<br/></li><li>Schaffung eines Straftatbestands, mit welchem die Behinderung der Hilfeleistung kriminalisiert wird<br/></li></ul></p><h4>Hauptgesichtspunkte des Entwurfs</h4><p><span style=\"background-color: initial;\">Im Bereich des Strafgesetzbuches dient der Entwurf zum einen der Umsetzung der Richtlinie Terrorismus. Gleichzeitig dienen einige der vorgeschlagenen Änderungen der Schaffung der Voraussetzungen für eine mögliche Ratifizierung Österreichs des Zusatzprotokolls zum Übereinkommen des Europarats zur Verhütung des Terrorismus sowie der Umsetzung der VN-Sicherheitsratsresolution 2178 (2014) vom 24. September 2014.</span></p><p>Die Richtlinie enthält Mindestvorschriften für die Definition von Straftatbeständen und die Festlegung von Sanktionen auf dem Gebiet von terroristischen Straftaten, Straftaten im Zusammenhang mit einer terroristischen Vereinigung und Straftaten im Zusammenhang mit terroristischen Aktivitäten sowie Maßnahmen zum Schutz, zur Unterstützung und zur Hilfe der Opfer des Terrorismus. </p><p>Im Bereich der Strafprozessordnung beinhaltet der vorliegende Ministerialentwurf insbesondere Regelungen zur Umsetzung der Richtlinie Terrorismus durch Regelung der Rechte der Opfer terroristischer Straftaten.</p><p><strong>Redaktion: <a href=\"https://help.gv.at/\"><strong>HELP.gv.at</strong></a></strong><br/></p></div>","teil2":null,"titel":null},"url":"/gegenstand/XXVI/ME/53","zitation":"53/ME","zukz":null}],"process":"J","progress":[{"empty":false,"id":1,"name":"Einlangen NR"},{"empty":false,"id":3,"name":"Ausschussberatungen NR"},{"empty":false,"id":4,"name":"Plenarberatungen NR"},{"empty":false,"id":5,"name":"Einlangen BR"},{"empty":false,"id":6,"name":"Ausschussberatungen BR"},{"empty":false,"id":7,"name":"Plenarberatungen BR"}],"reference":[{"art":"B","subject":"Strafrechtsänderungsgesetz 2018","text":"Bezug zu","url":"/gegenstand/XXVI/ME/53","zitation":"53/ME"}],"shortinfo":{"stand":"<strong>Stand: 04.07.2018</strong>","teil1":"<ul class=\"unordered-list\"><li>Erweiterung der inländischen Gerichtsbarkeit im Zusammenhang mit Terrorismus</li><li>Erweiterung des Kataloges der terroristischen Straftaten in § 278c Abs. 1 StGB</li></ul>","teil2":"<div class=\"more\"><ul class=\"unordered-list\"><li>Erweiterung des Katalogs finanzierungstauglicher Straftaten in § 278d Abs. 1 StGB</li><li>Einführung eines neuen Straftatbestandes „Reisen für terroristische Zwecke“ (§ 278g StGB)</li><li>Erweiterung des Personenkreises, welcher einen Anspruch auf Prozessbegleitung iSd § 66 Abs. 2 StPO hat, auf Opfer terroristischer Straftaten (§ 278c StGB)</li></ul></div>","titel":"Schwerpunkte der Regierungsvorlage"},"sntype":"Regierungsvorlage: Bundes(verfassungs)gesetz","statements":{"documents":[{"documents":[{"link":"/dokument/XXVI/I/252/fname_701797.pdf","type":"PDF"},{"link":"/dokument/XXVI/I/252/fnameorig_701797.html","type":"HTML"}],"title":"Gesetzestext"}],"filter":{"data":{"definition":{"ascDesc":"DESC","bez":"FP_142_vhg","fixedParams":{"BEZUG_GP_CODE":["XXVI"],"BEZUG_INR":[252],"BEZUG_ITYP":["I"]},"hideColumns":["16","17"],"hideDimensions":["BEZUG_GP_CODE","BEZUG_ITYP","BEZUG_INR"],"listeId":142,"params":{"BEZUG_GP_CODE":["XXVI"],"BEZUG_INR":[252],"BEZUG_ITYP":["I"]},"sortrnr":5},"hasForm":true,"hasList":true,"label":"Stellungnahmen","pagesize":20,"resultLayout":"TABLE","type":"FILTER"},"rendertype":"filter"},"new":0},"statementsstate":"0","status":{"bgbllinks":[{"link":"http://www.ris.bka.gv.at/Dokument.wxe?Abfrage=BgblAuth&Dokumentnummer=BGBLA_2018_I_70","title":"Bundesgesetzblatt I Nr. 70/2018","type":"DEFAULT"},{"link":"http://www.ris.bka.gv.at/Ergebnis.wxe?Abfrage=Bundesnormen&Kundmachungsorgan=BGBl.+I+Nr.&Kundmachungsnummer=70%2f2018&Suchworte=&ReturnUrl=%2fSuch