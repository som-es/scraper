{"content":{"approvalstate":"9 Keine Zustimmung bei dem Doktyp \"RV\" möglich","breadcrumbs":[{"title":"Start","url":"/"},{"title":"Gesetzesinitiativen","url":"/recherchieren/gegenstaende/gesetzesinitiativen/"},{"title":"Nationalrat - XXVII. GP","url":"/recherchieren/gegenstaende/gesetzesinitiativen/?GP=XXVII"},{"title":"Regierungsvorlage: Bundes(verfassungs)gesetz","url":"/recherchieren/gegenstaende/gesetzesinitiativen/?GP=XXVII&RGES=RV"},{"title":"2704 d.B."}],"correspondence":[{"additional":false,"date":"29.07.2024","title":"Neu im Budgetausschuss","url":"/aktuelles/pk/jahr_2024/pk0851#XXVII_I_02704"}],"deleted":false,"description":"Bundesgesetz, mit dem das Bundeshaushaltsgesetz 2013 geändert wird","documents":[{"documents":[{"link":"/dokument/XXVII/I/2704/fname_1642524.pdf","type":"PDF"},{"link":"/dokument/XXVII/I/2704/fnameorig_1642524.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVII/I/2704/fname_1642526.pdf","type":"PDF"},{"link":"/dokument/XXVII/I/2704/fnameorig_1642526.html","type":"HTML"}],"title":"Erläuterungen"},{"documents":[{"link":"/dokument/XXVII/I/2704/imfname_1642527.pdf","type":"PDF"}],"title":"Textgegenüberstellung"},{"documents":[{"link":"/dokument/XXVII/I/2704/imfname_1642528.pdf","type":"PDF"}],"title":"Vorblatt und WFA"}],"doktyp":"RV","einlangen":"2024-07-05T00:00:00","eurovoc":{"data":{"bubbles":[{"label":"Öffentliche Finanzen und Haushaltspolitik","link":"/recherchieren/gegenstaende/?NRBR=NR&GP_CODE=XXVII&EUROVOC=Öffentliche Finanzen und Haushaltspolitik"}],"title":""},"rendertype":"bubbles"},"gp_code":"XXVII","group":"1","headwords":{"data":{"bubbles":[{"label":"Bundeshaushalt III. Sonstiges","link":"/recherchieren/gegenstaende/?NRBR=NR&GP_CODE=XXVII&SW=Bundeshaushalt III. Sonstiges"}],"title":""},"rendertype":"bubbles"},"history_ind":2,"inr":2704,"intranet":"N","ityp":"I","names":[{"frak_code":null,"funktext":"Mitglied der Bundesregierung","ltext":"Bundesministerium für Finanzen","name":"Dr. Magnus Brunner, LL.M.","portrait":{"data":{"alt":"Portraitfoto von Dr. Magnus Brunner, LL.M.","bildId":20104091,"copyright":"Andy Wenzel/BKA","src":"/dokument/bild/201040/20104091_384.jpg"},"rendertype":"image"},"url":"/person/55727"}],"nr_gp_code":"XXVII","phase":[{"documents":null,"id":1,"name":"Einlangen NR","stages":[{"date":"05.07.2024","priority":1,"text":"Einlangen im Nationalrat"},{"date":"05.07.2024","fsth":[{"fund_bis":6,"fund_von":4,"gp_code":"XXVII","sitzung_id":275,"title":"Seite 4 des Stenographischen Protokolls der 275. Sitzung des Nationalrats","url":"/dokument/XXVII/NRSITZ/275/fnameorig_1684271.html#TEXTOBJ_330447"}],"text":"<a href=\"/gegenstand/XXVII/NRSITZ/275\">275. Sitzung des Nationalrates</a>: Mitteilung des Einlangens"},{"date":"08.07.2024","text":"Vorgesehen für den <a href=\"/ausschuss/XXVII/A-BU/1/00867\">Budgetausschuss</a>"}]},{"documents":null,"id":3,"name":"Ausschussberatungen NR","stages":[{"date":"18.09.2024","fsth":[{"fund_bis":199,"fund_von":189,"gp_code":"XXVII","sitzung_id":276,"title":"Seite 189 des Stenographischen Protokolls der 276. Sitzung des Nationalrats","url":"/dokument/XXVII/NRSITZ/276/fnameorig_1685110.html#TEXTOBJ_331642"}],"priority":1,"text":"<a href=\"/gegenstand/XXVII/NRSITZ/276\">276. Sitzung des Nationalrates</a>: Zuweisung an den <a href=\"/ausschuss/XXVII/A-BU/1/00867\">Budgetausschuss</a>"}]}],"preconst":[{"betreff":"Bundeshaushaltsgesetz, Änderung","description":"Ministerialentwurf betreffend Bundesgesetz, mit dem das Bundeshaushaltsgesetz 2013 geändert wird","documents":[{"documents":[{"link":"/dokument/XXVII/ME/346/imfname_1633316.pdf","type":"PDF"}],"title":"Kurzinformation"},{"documents":[{"link":"/dokument/XXVII/ME/346/imfname_1633292.pdf","type":"PDF"}],"title":"Begleitschreiben"},{"documents":[{"link":"/dokument/XXVII/ME/346/fname_1633293.pdf","type":"PDF"},{"link":"/dokument/XXVII/ME/346/fnameorig_1633293.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVII/ME/346/imfname_1633294.pdf","type":"PDF"}],"title":"Vorblatt und wirkungsorientierte Folgenabschätzung"},{"documents":[{"link":"/dokument/XXVII/ME/346/fname_1633295.pdf","type":"PDF"},{"link":"/dokument/XXVII/ME/346/fnameorig_1633295.html","type":"HTML"}],"title":"Erläuterungen"},{"documents":[{"link":"/dokument/XXVII/ME/346/imfname_1633296.pdf","type":"PDF"}],"title":"Textgegenüberstellung"}],"gp_code":"XXVII","inr":346,"ityp":"ME","shortinfo":{"redaktion":"<p class=\"kurzinfoStand\"><strong>Redaktion: <a href=\"https://oesterreich.gv.at/\"><strong>oesterreich.gv.at</strong></a></strong><br/></p>","stand":"07.06.2024","teil1":"<h4>Ziel</h4>\n\n<p>Sicherstellung von Verbesserungen und Klarstellungen im Haushaltsrecht</p>\n\n<h4>Inhalt</h4>\n\n<p>Novelle des Bundeshaushaltsgesetzes 2013 (BHG 2013)</p>\n","teil2":"<h4>Hauptgesichtspunkte des Entwurfs</h4>\n\n<p>Mit dem Entwurf sollen legistisch, prozedural oder redaktionell notwendige Anpassungen wie etwa Harmonisierungen widerspr&uuml;chlicher Regelungen, Klarstellungen, Vereinfachungen oder die Einarbeitung von Bundesministeriengesetz-Novellen (BMG-Novellen) vorgenommen werden.</p>\n\n<p>Klarstellungen im Sinne der bisherigen Praxis</p>\n\n<ul class=\"unordered-list\">\n\t<li>Geltung der allgemeinen Ausweichklausel des Stabilit&auml;ts- und Wachstumspaktes im Rahmen der Schuldenbremse gleichziehen mit dem &Ouml;sterreichischen Stabilit&auml;tspakt</li>\n\t<li>Gesetzliche Verankerung der vereinfachten wirkungsorientierten Folgenabsch&auml;tzung (WFA) und der WFA-B&uuml;ndelungen</li>\n\t<li>Harmonisierung der Formulierungen zu den haushaltsrechtlichen Sanktionen</li>\n\t<li>Klarstellung des F&ouml;rderungsbegriffs: Finanzzuweisungen, finanzausgleichsrechtliche Zusch&uuml;sse an Gebietsk&ouml;rperschaften, Zusch&uuml;sse mit Sozialleistungscharakter sind keine F&ouml;rderung.</li>\n\t<li>Praxisnahe Klarstellung der Verordnungserm&auml;chtigung f&uuml;r die Allgemeinen Rahmenrichtlinien bez&uuml;glich Betrauung von Abwicklungsstellen</li>\n\t<li>Definition der liquiden Mittel</li>\n\t<li>Finanzanlagen bzw. Beteiligungen im Treasury abzubilden</li>\n</ul>\n\n<p>Vereinfachungen</p>\n\n<ul class=\"unordered-list\">\n\t<li>Bestimmungen f&uuml;r Vertretungsbeh&ouml;rden im Ausland mit geringem Personalstand</li>\n\t<li>Harmonisierung der Berichtspflichten zum Personalstand von Besch&auml;ftigten in ausgegliederten Einrichtungen</li>\n\t<li>Entfall der bundesinternen Verrechnung fiktiver Mieten bei Burghauptmannschaft, da kein Steuerungseffekt bei hohem Verwaltungsaufwand</li>\n\t<li>Entfall der zwingenden Entgeltlichkeit beim Sachg&uuml;teraustausch</li>\n</ul>\n\n<p>Bereinigungen</p>\n\n<ul class=\"unordered-list\">\n\t<li>Mittelverwendungsgruppe &quot;operative Verwaltungst&auml;tigkeit&quot;&nbsp;in Personalauszahlungen und betrieblichen Sachaufwand (&sect; 33) teilen sowie eine Mittelverwendungsgruppe f&uuml;r Finanzertr&auml;ge/Finanzaufwand</li>\n\t<li>F&ouml;rderungen im Namen anderer Rechtstr&auml;ger, die vom Bund finanziert werden, sind gesondert auszuweisen. (bisher nur freiwillig praktiziert)</li>\n\t<li>Erg&auml;nzung zu den datenschutzrechtlichen Bestimmungen</li>\n</ul>\n","titel":"Kurzinformation"},"url":"/gegenstand/XXVII/ME/346","zitation":"346/ME","zukz":null}],"process":"J","progress":[{"empty":false,"id":1,"name":"Einlangen NR"},{"empty":false,"id":3,"name":"Ausschussberatungen NR"},{"empty":true,"id":4,"name":"Plenarberatungen NR"},{"empty":true,"id":5,"name":"Einlangen BR"},{"empty":true,"id":6,"name":"Ausschussberatungen BR"},{"empty":true,"id":7,"name":"Plenarberatungen BR"}],"reference":[{"art":"B","subject":"Bundeshaushaltsgesetz, Änderung","text":"Bezug zu","url":"/gegenstand/XXVII/ME/346","zitation":"346/ME"}],"shortinfo":{"stand":"05.07.2024","teil1":"<p>Novelle des BHG 2013</p>\n","teil2":null,"titel":"Kurzinformation"},"sntype":"Regierungsvorlage: Bundes(verfassungs)gesetz","statements":{"documents":[{"documents":[{"link":"/dokument/XXVII/I/2704/fname_1642524.pdf","type":"PDF"},{"link":"/dokument/XXVII/I/2704/fnameorig_1642524.html","type":"HTML"}],"title":"Gesetzestext"}],"filter":{"data":{"definition":{"ascDesc":"DESC","bez":"FP_142_vhg","fixedParams":{"BEZUG_GP_CODE":["XXVII"],"BEZUG_INR":[2704],"BEZUG_ITYP":["I"]},"hideColumns":["16","17"],"hideDimensions":["BEZUG_GP_CODE","BEZUG_ITYP","BEZUG_INR"],"listeId":142,"params":{"BEZUG_GP_CODE":["XXVII"],"BEZUG_INR":[2704],"BEZUG_ITYP":["I"]},"sortrnr":5},"hasForm":true,"hasList":true,"label":"Stellungnahmen","pagesize":20,"resultLayout":"TABLE","type":"FILTER"},"rendertype":"filter"},"new":0},"statementsstate":"0","status":{"description":"Zugewiesen an: <a href=\"/ausschuss/XXVII/A-BU/1/00867\">Budgetausschuss</a>, Beratungen nicht aufgenommen","number":2},"title":"Bundeshaushaltsgesetzes 2013, Änderung","topics":{"data":{"bubbles":[{"label":"Budget und Finanzen","link":"/suche?thema=Budget und Finanzen"}],"title":""},"rendertype":"bubbles"},"type":"Regierungsvorlage: Bundes(verfassungs)gesetz","update":"2025-12-22T17:05:32","vhg_fertig":"J","vhg_fertig_docs":"J","zitation":"2704 d.B."},"meta":{"description":"Bundeshaushaltsgesetzes 2013, Änderung (2704 d.B.)","generationTime":"Mon Dec 22 16:05:37 UTC 2025","keywords":"\"Bundeshaushalt III. Sonstiges\"","lang":"de","openGraph":{"description":"2704 d.B.","image":"https://www.parlament.gv.at/static/img/og.png","title":"Bundeshaushaltsgesetzes 2013, Änderung | Parlament Österreich"},"scripts":[],"styles":[],"title":"Bundeshaushaltsgesetzes 2013, Änderung (2704 d.B.) | Parlament Österreich"},"pagetype":"geschichtsseite"}