nts":[{"documents":[{"link":"/dokument/BR/I-BR/11669/fname_1702940.pdf","type":"PDF"},{"link":"/dokument/BR/I-BR/11669/fnameorig_1702940.html","type":"HTML"}],"title":"Berichterstattung"}],"id":6,"name":"Ausschussberatungen BR","stages":[{"date":"10.07.2025","text":"Zuweisung an den <a href=\"/ausschuss/BR/A-IN-BR/1/00108\">Ausschuss für innere Angelegenheiten des Bundesrates</a>"},{"date":"15.07.2025","priority":1,"text":"Ausschuss für innere Angelegenheiten des Bundesrates: Bericht <a href=\"/gegenstand/BR/I-BR/11669\">11669/BR d.B.</a>"},{"date":"15.07.2025","text":"Ausschuss für innere Angelegenheiten des Bundesrates: auf <a href=\"/dokument/BR/A-IN-BR/1/00108/TO_16617089.html\">Tagesordnung</a> in der <a href=\"/ausschuss/BR/A-IN-BR/1/00108?selectedStage=105&selectedSession=2&selectedDate=15072025\">2. Sitzung des Ausschusses</a>"}]},{"correspondence":[{"additional":false,"date":"17.07.2025","title":"Messenger-Überwachung nimmt letzte parlamentarische Hürde","url":"/aktuelles/pk/jahr_2025/pk0718#XXVIII_I_00136"}],"documents":[{"documents":[{"link":"/dokument/BR/UEA-BR/763/imfname_1703415.pdf","type":"PDF"}],"title":"Unselbstständiger Entschließungsantrag (gescanntes Original)"},{"documents":[{"link":"/dokument/XXVIII/BNR/40/fname_1701042.pdf","type":"PDF"},{"link":"/dokument/XXVIII/BNR/40/fnameorig_1701042.html","type":"HTML"}],"title":"Gesetzestext"},{"documents":[{"link":"/dokument/XXVIII/BNR/40/fname_1701043.pdf","type":"PDF"},{"link":"/dokument/XXVIII/BNR/40/fnameorig_1701043.html","type":"HTML"}],"title":"Beschlussformel NR"},{"documents":[{"link":"/dokument/XXVIII/BNR/40/fname_1703436.pdf","type":"PDF"},{"link":"/dokument/XXVIII/BNR/40/fnameorig_1703436.html","type":"HTML"}],"title":"Beschlussformel BR"}],"id":7,"name":"Plenarberatungen BR","stages":[{"date":"17.07.2025","text":"Auf der Tagesordnung der <a href=\"/gegenstand/BR/BRSITZ/980\">980. Sitzung</a>"},{"date":"17.07.2025","fsth":[{"fund_bis":null,"fund_von":null,"gp_code":"BR","sitzung_id":980,"te